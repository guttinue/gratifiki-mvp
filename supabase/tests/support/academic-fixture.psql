-- Transaction-local synthetic roots only. Does not provision an application session
-- or grant bypasses; access assertions must explicitly SET LOCAL ROLE authenticated.
create function pg_temp.fixture(label text) returns uuid language sql immutable as $$
 select md5('academic-test:' || label)::uuid;
$$;
create function pg_temp.login_as(label text) returns void language plpgsql as $$
begin
 perform set_config('request.jwt.claim.sub',pg_temp.fixture(label)::text,true);
 perform set_config('request.jwt.claims',jsonb_build_object('sub',pg_temp.fixture(label),'role','authenticated')::text,true);
end;
$$;
insert into auth.users (id,email,aud,role) values
