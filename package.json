{
  "name": "gratifiki-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "db:test": "supabase test db",
    "verify:isolated": "node --experimental-strip-types scripts/verification/run.ts",
    "verify:restore": "node --experimental-strip-types scripts/verification/restore-run.ts",
    "demo:academic": "node --experimental-strip-types scripts/bootstrap/academicDemo-run.ts",
    "demo:evaluators": "node --experimental-strip-types scripts/bootstrap/evaluatorKits-run.ts",
    "demo:users": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/create-demo-users.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "29.0.0",
    "supabase": "2.118.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
