VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-the-local-publishable-key
VITE_RUNTIME_MODE=local
# Default deny: remote mode requires demo_remote + exact approved HTTPS API hostname.
VITE_ALLOWED_DEMO_HOSTS=

# Copy this file to the ignored `.env.local`, fill only with local values, and never use remote credentials.
# Provision synthetic accounts explicitly; do not reset a database in use.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-local-service-role-key
DEMO_TECHNICAL_EMAIL=technical@example.invalid
DEMO_TECHNICAL_PASSWORD=replace-with-a-local-password
DEMO_CAM_EMAIL=cam@example.invalid
DEMO_CAM_PASSWORD=replace-with-a-local-password

# Academic bootstrap: supply these via a protected process environment.
